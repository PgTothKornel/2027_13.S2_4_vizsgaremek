{
  "name": "pnpm",
  "publishConfig": {
    "executableFiles": [
      "./dist/node-gyp-bin/node-gyp",
      "./dist/node-gyp-bin/node-gyp.cmd",
      "./dist/node_modules/node-gyp/bin/node-gyp.js",
      "./dist/node_modules/node-gyp/gyp/gyp_main.py",
      "./dist/node_modules/node-gyp/gyp/gyp"
    ]
  },
  "version": "12.11.2",
  "description": "Fast, disk space efficient package manager",
  "keywords": [
    "pnpm",
    "package manager",
    "rust"
  ],
  "license": "MIT",
  "homepage": "https://pnpm.io",
  "bugs": "https://github.com/pnpm/pnpm/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/pnpm/pnpm",
    "directory": "pnpm/npm/pnpm"
  },
  "bin": {
    "pnpm": "pnpm.exe",
    "pn": "pn.exe",
    "pnpx": "pnpx.exe",
    "pnx": "pnx.exe"
  },
  "type": "module",
  "engines": {
    "node": ">=18.*"
  },
  "files": [
    "pnpm",
    "pn",
    "pnpx",
    "pnx",
    "bin/",
    "install.js",
    "native-binary.mjs",
    "dist/",
    "THIRD-PARTY-NOTICES.md"
  ],
  "optionalDependencies": {
    "@pnpm/exe.win32-x64": "12.11.2",
    "@pnpm/exe.win32-arm64": "12.11.2",
    "@pnpm/exe.darwin-x64": "12.11.2",
    "@pnpm/exe.darwin-arm64": "12.11.2",
    "@pnpm/exe.linux-x64": "12.11.2",
    "@pnpm/exe.linux-arm64": "12.11.2",
    "@pnpm/exe.linux-riscv64": "12.11.2",
    "@pnpm/exe.linux-ppc64": "12.11.2",
    "@pnpm/exe.linux-s390x": "12.11.2",
    "@pnpm/exe.linux-x64-musl": "12.11.2",
    "@pnpm/exe.linux-arm64-musl": "12.11.2",
    "@pnpm/exe.freebsd-x64": "12.11.2",
    "@pnpm/exe.android-arm64": "12.11.2",
    "@pnpm/exe.android-x64": "12.11.2"
  },
  "scripts": {
    "preinstall": "node install.js",
    "postinstall": "node install.js",
    "bundle-node-gyp": "node scripts/bundle-node-gyp.mjs"
  }
}