generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Kategoria {
  id        Int      @id
  kategoria String   @db.VarChar(255)
  recept    recept[]
}

model alapanyag {
  id                           Int                            @id
  nev                          String                         @db.VarChar(255)
  tapanyag                     Json                           @db.Json
  allergen_alapanyag_osszekoto allergen_alapanyag_osszekoto[]
  huto                         huto[]
  recept_alapanyag_osszekoto   recept_alapanyag_osszekoto[]
  velemeny_alapanyagrol        velemeny_alapanyagrol[]
}

model allergen_alapanyag_osszekoto {
  alapanyag_id Int
  allergen_id  Int
  alapanyag    alapanyag  @relation(fields: [alapanyag_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "allergen_alapanyag_osszekoto_alapanyag_id_foreign")
  allergenek   allergenek @relation(fields: [allergen_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "allergen_alapanyag_osszekoto_allergen_id_foreign")

  @@id([alapanyag_id, allergen_id])
}

model allergen_fiok_osszekoto {
  fiok_id     Int
  allergen_id Int
  allergenek  allergenek @relation(fields: [allergen_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "allergen_fiok_osszekoto_allergen_id_foreign")
  fiok        fiok       @relation(fields: [fiok_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "allergen_fiok_osszekoto_fiok_id_foreign")

  @@id([fiok_id, allergen_id])
}

model allergenek {
  id                           Int                            @id
  nev                          String                         @db.VarChar(255)
  allergen_alapanyag_osszekoto allergen_alapanyag_osszekoto[]
  allergen_fiok_osszekoto      allergen_fiok_osszekoto[]
}

model fiok {
  id                      Int                       @id
  etrend                  String                    @db.VarChar(255)
  profil_id               Int
  allergen_fiok_osszekoto allergen_fiok_osszekoto[]
  profil                  profil                    @relation(fields: [profil_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fiok_profil_id_foreign")
  velemeny_alapanyagrol   velemeny_alapanyagrol[]
  velemeny_receptrol      velemeny_receptrol[]
}

model huto {
  alapanyag_id Int
  profil_id    Int
  alapanyag    alapanyag @relation(fields: [alapanyag_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "huto_alapanyag_id_foreign")
  profil       profil    @relation(fields: [profil_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "huto_profil_id_foreign")

  @@id([profil_id, alapanyag_id])
}

model mertekegysegek {
  id       Int    @id
  nev      String @db.VarChar(255)
  egysegek Json   @db.Json
}

model profil {
  id       Int      @id
  email    String   @db.VarChar(255)
  password String   @db.VarChar(255)
  created  DateTime @db.Timestamp(0)
  fiok     fiok[]
  huto     huto[]
}

model recept {
  id                         Int                          @id
  nev                        String                       @db.VarChar(255)
  leiras                     String                       @db.VarChar(255)
  adag                       Int
  ido                        Int
  kategoria_id               Int
  kep                        Json?                        @db.Json
  tapanyagok                 Json?                        @db.Json
  lepesek                    Json?                        @db.Json
  Kategoria                  Kategoria                    @relation(fields: [kategoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "recept_kategoria_id_foreign")
  recept_alapanyag_osszekoto recept_alapanyag_osszekoto[]
  velemeny_receptrol         velemeny_receptrol[]
}

model recept_alapanyag_osszekoto {
  alapanyag_id Int
  recept_id    Int
  alapanyag    alapanyag @relation(fields: [alapanyag_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "recept_alapanyag_osszekoto_alapanyag_id_foreign")
  recept       recept    @relation(fields: [recept_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "recept_alapanyag_osszekoto_recept_id_foreign")

  @@id([recept_id, alapanyag_id])
}

model velemeny_alapanyagrol {
  fiok_id      Int
  alapanyag_id Int
  velemeny     String    @db.VarChar(255)
  id           Int       @id @default(autoincrement())
  alapanyag    alapanyag @relation(fields: [alapanyag_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "velemeny_alapanyagrol_alapanyag_id_foreign")
  fiok         fiok      @relation(fields: [fiok_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "velemeny_alapanyagrol_fiok_id_foreign")
}

model velemeny_receptrol {
  fiok_id   Int
  recept_id Int
  velemeny  String @db.VarChar(255)
  id        Int    @id @default(autoincrement())
  fiok      fiok   @relation(fields: [fiok_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "velemeny_receptrol_fiok_id_foreign")
  recept    recept @relation(fields: [recept_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "velemeny_receptrol_recept_id_foreign")
}
