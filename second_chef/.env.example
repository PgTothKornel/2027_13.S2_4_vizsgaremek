# Runtime connection supplied by your PostgreSQL provider. Never commit real keys.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Optional direct connection for explicitly running database maintenance.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require"
# Required: an existing fiok.id. The project's seed uses account 1.
TEST_USER_ID=1
# Optional HTTPS cloud/CDN folder. Leave empty to use database URLs and the photo catalog.
# Legacy paths resolve below this prefix, e.g. BASE/img/receptek/gulyasleves.jpg.
RECIPE_IMAGE_BASE_URL=""
